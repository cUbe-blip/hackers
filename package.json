{
  "name": "hackers-news",
  "version": "0.0.1",
  "author": "Ilya Yasinski",
  "type": "module",
  "engines": {
    "node": ">=18.11.0",
    "pnpm": ">=7.1.0"
  },
  "scripts": {
    "serve": "vite preview --port 8080",
    "build": "vite build",
    "dev": "vite dev --port 8081",
    "dev:update-deps": "rm -rf pnpm-lock.yaml node_modules/ **/node_modules && pnpm install",
    "format": "prettier --write .",
    "lint:format": "prettier --cache --check .",
    "lint": "eslint --cache .",
    "tsc:check": "tsc",
    "vitest:run": "vitest run",
    "test": "jest"
  },
  "dependencies": {
    "@react-hook/media-query": "^1.1.1",
    "axios": "^1.7.9",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.1",
    "react-router-dom": "^7.1.1",
    "react-transition-group": "^4.4.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@nkzw/eslint-config": "^1.19.0",
    "@swc/core": "^1.10.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-transition-group": "^4.4.12",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "jest": "^29.7.0",
    "npm-run-all2": "^6.2.6",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "sass": "^1.83.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^1.6.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
}
